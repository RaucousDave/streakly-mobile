# ---------------------------------------------------------------------------
# Streakly Mobile – Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values before running the app.
# All variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle
# at build time and are visible to the client – never put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the Go API (no trailing slash).
# Local Android emulator default: http://10.0.2.2:8000/api/v1
# Local iOS simulator default:    http://localhost:8000/api/v1
# Production Render deployment:   https://your-app.onrender.com/api/v1
EXPO_PUBLIC_API_URL= 172.18.64.1

# Google OAuth Web Client ID – required for Google Sign-In on both platforms.
# Obtain from Google Cloud Console > APIs & Services > Credentials.
# The Web Client ID is used to verify the ID token on the Go backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
